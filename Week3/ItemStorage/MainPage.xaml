<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ItemStorage.Models"
    x:Class="ItemStorage.MainPage"
    Title="Item Storage">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
          RowSpacing="15">

        <Label Grid.Row="0"
               Text="Ulysses Burden III - Item Storage"
               Style="{StaticResource Headline}"
               SemanticProperties.HeadingLevel="Level1"/>

        <Label Grid.Row="1"
               Text="Please provide the following information:"/>

        <Entry Grid.Row="2"
               x:Name="txtItemID"
               Placeholder="Item ID"/>

        <Entry Grid.Row="3"
               x:Name="txtItemName"
               Placeholder="Item Name"/>

        <Entry Grid.Row="4"
               x:Name="txtItemDescription"
               Placeholder="Item Description"/>

        <Button Grid.Row="5"
                Text="Save"
                Clicked="OnSaveClicked"
                HorizontalOptions="Center"/>

        <CollectionView Grid.Row="6"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Item">
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding ItemID}"
                               FontAttributes="Bold"/>
                        <Label Text="{Binding ItemName}"/>
                        <Label Text="{Binding ItemDescription}"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>
