<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AddSubtractApp.ResultPage"
    Title="Calculation Result">

    <VerticalStackLayout
        Padding="25"
        Spacing="20">

        <!-- Student name -->
        <Label
            Text="Ulysses Burden III"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center"/>

        <!-- Display the two entered numbers -->
        <Label
            x:Name="lblNumbers"
            FontSize="18"
            HorizontalOptions="Center"/>

        <!-- Display addition or subtraction result -->
        <Label
            x:Name="lblResult"
            FontSize="22"
            FontAttributes="Bold"
            HorizontalOptions="Center"/>

        <!-- Return to MainPage -->
        <Button
            Text="Go Back"
            Clicked="OnGoBackClicked"/>

    </VerticalStackLayout>

</ContentPage>
