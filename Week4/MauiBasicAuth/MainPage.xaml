<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiBasicAuth.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <!-- Application heading -->
            <Label
                Text="Ulysses Burden Basic Authentication"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"/>

            <!-- Username input -->
            <Entry
                x:Name="txtUserId"
                Placeholder="User ID"/>

            <!-- Password input -->
            <Entry
                x:Name="txtPassword"
                Placeholder="Password"
                IsPassword="True"/>

            <!-- Login button -->
            <Button
                Text="Login"
                Clicked="OnLoginClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
